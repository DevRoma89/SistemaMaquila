@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="d-flex align-center">
            <MudIcon Icon="@(IsEditMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" 
                     Color="@(IsEditMode ? Color.Primary : Color.Success)" 
                     Class="mr-2" />
            @(IsEditMode ? "Editar Empleado" : "Nuevo Empleado")
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="form" Model="@Modelo">
            <MudGrid>
                <!-- Nombre -->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Modelo.Nombre" 
                                  Label="Nombre *"
                                  Placeholder="Ingrese el nombre"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Badge"
                                  For="@(() => Modelo.Nombre)"
                                  Required="true"
                                  RequiredError="El nombre es obligatorio"
                                  Immediate="true">
                     
                    </MudTextField>
                </MudItem>

                <!-- Apellido -->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Modelo.Apellido" 
                                  Label="Apellido *"
                                  Placeholder="Ingrese el apellido"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Badge"
                                  For="@(() => Modelo.Apellido)"
                                  Required="true"
                                  RequiredError="El apellido es obligatorio"
                                  Immediate="true">
                        
                    </MudTextField>
                </MudItem>

                <!-- Costo por minuto -->
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="Modelo.CostoMinutoBase" 
                                     Label="Costo por minuto *"
                                     Placeholder="0.00"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                                     Format="C"
                                     Min="0.01m"
                                     Max="999999.99m"
                                     Step="0.01m" 
                                     Required="true"
                                     RequiredError="Debe ingresar un costo mayor a 0"
                                     HelperText="El costo por minuto debe ser mayor a 0">
                        
                      
                    </MudNumericField>
                </MudItem>

                <!-- Línea de producción -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" 
                               @bind-Value="Modelo.LineaId" 
                               Label="Línea de producción *"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.Factory"
                               Required="true"
                               RequiredError="Debe seleccionar una línea" >
                        @if (!Lineas.Any())
                        {
                            <MudSelectItem Value="0" Disabled="true">
                                <MudText Color="Color.Error">No hay líneas disponibles</MudText>
                            </MudSelectItem>
                        }
                        else
                        {
                            @foreach (var linea in Lineas)
                            {
                                <MudSelectItem Value="@linea.Id">
                                    <div class="d-flex align-center">
                                       
                                       
                                        <MudText>@linea.Nombre</MudText>
                                         
                                    </div>
                                </MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>

                <!-- Información adicional en modo edición -->
                @if (IsEditMode && Modelo.Id > 0)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
                            <MudText Typo="Typo.body2">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                                Editando empleado con ID: <strong>@Modelo.Id</strong>
                            </MudText>
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" 
                   OnClick="Cancelar"
                   StartIcon="@Icons.Material.Filled.Close">
            Cancelar
        </MudButton>
        
        <MudButton Variant="Variant.Filled" 
                   Color="@(IsEditMode ? Color.Primary : Color.Success)"
                   OnClick="Guardar"
                   StartIcon="@(IsEditMode ? Icons.Material.Filled.Save : Icons.Material.Filled.Check)"
                   Disabled="@(!Lineas.Any() || string.IsNullOrEmpty(Modelo.Nombre) || string.IsNullOrEmpty(Modelo.Apellido))">
            @(IsEditMode ? "Actualizar" : "Crear")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public EmpleadoFormModel Modelo { get; set; } = new();
    [Parameter] public List<LineaGetDTO> Lineas { get; set; } = new();
    [Parameter] public bool IsEditMode { get; set; } = false;

    private MudForm form = default!;

    protected override void OnInitialized()
    {
        // Limpiar valores vacíos en modo creación
        if (!IsEditMode)
        {
            Modelo.Nombre ??= string.Empty;
            Modelo.Apellido ??= string.Empty;
        }
    }

    private async Task Guardar()
    {
        await form.ValidateAsync();

        if (!form.IsValid || !ValidarDatos())
        {
            Snackbar.Add("Por favor, corrija los errores antes de continuar", Severity.Warning);
            return;
        }

        MudDialog.Close(DialogResult.Ok(Modelo));
    }

    private bool ValidarDatos()
    {
        if (string.IsNullOrWhiteSpace(Modelo.Nombre))
        {
            Snackbar.Add("El nombre es obligatorio", Severity.Error);
            return false;
        }

        if (string.IsNullOrWhiteSpace(Modelo.Apellido))
        {
            Snackbar.Add("El apellido es obligatorio", Severity.Error);
            return false;
        }

        if (Modelo.CostoMinutoBase <= 0)
        {
            Snackbar.Add("El costo por minuto debe ser mayor a 0", Severity.Error);
            return false;
        }

        if (Modelo.LineaId <= 0)
        {
            Snackbar.Add("Debe seleccionar una línea de producción", Severity.Error);
            return false;
        }

        return true;
    }

    private void Cancelar() => MudDialog.Cancel();
     
}